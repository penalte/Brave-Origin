 {
 	assert(view);
+	/* Preserve both axes; the 0.9 API takes an axis enum, not a bool. */
+	if (view->maximized == VIEW_AXIS_BOTH && axis != VIEW_AXIS_BOTH) {
+		view->impl->maximize(view, VIEW_AXIS_BOTH);
+		return;
+	}
 
