+    async def _size_wayland_screen(self, width: int, height: int) -> None:
+        """Size the primary's screen (output 0) to its display rectangle.
+
+        A capture start sizes the view alone; the screen must already hold it.
+        Without this the nested application compositor keeps the geometry it was
+        created with, so a browser started before the first client keeps the
+        startup size inside an otherwise correctly sized stream.
+        """
+        module = self._wayland_control_module()
+        if module is None or width <= 0 or height <= 0:
+            return
+        scale = float((self.display_clients.get('primary') or {}).get('scale', 1.0) or 1.0)
+        try:
+            ok = await asyncio.to_thread(module.resize_output, 0, width, height, scale)
+            if not ok:
+                data_logger.warning(f"Wayland screen resize to {width}x{height} refused.")
+        except Exception as error:
+            data_logger.error(f"Wayland resize_output failed: {error}")
+
     async def _reconfigure_displays_locked(self) -> None:
