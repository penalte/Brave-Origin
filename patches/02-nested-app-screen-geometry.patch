+        async def settle_app_screen() -> None:
+            # A session accepts a screen mode whether or not it yet has a window
+            # to lay out, and during bring-up it usually has none: an
+            # application started alongside the desktop maps its own window
+            # after this point and then keeps whatever geometry it was given.
+            # Applying the same configuration again over the first seconds of
+            # the session covers that window without waiting on it.
+            elapsed = 0.0
+            for delay in (2.0, 6.0, 12.0):
+                await asyncio.sleep(delay)
+                elapsed += delay
+                await configure_app_screen(f"settle +{elapsed:g}s")
+
+        await configure_app_screen("immediate")
+        pending = getattr(self, "_app_screen_settle", None)
+        if pending is not None and not pending.done():
+            pending.cancel()
