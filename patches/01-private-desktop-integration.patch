+// The authenticated outer portal owns session state and the logout token.
+function PrivateSessionControls() {
+  const [session, setSession] = useState(null);
+  useEffect(() => {
+    const receive = event => {
+      if (event.origin !== window.location.origin || event.source !== window.parent) return;
+      if (event.data?.type === 'brave-session-state') setSession(event.data);
+    };
+    window.addEventListener('message', receive);
+    if (window.parent !== window) window.parent.postMessage({type:'brave-session-ready'}, window.location.origin);
+    return () => window.removeEventListener('message', receive);
+  }, []);
+  if (!session?.active) return null;
+  return <section aria-label="Browser session" style={{padding:'12px 16px',borderBottom:'1px solid var(--border-color)'}}>
+    <div title={session.name} style={{fontSize:'13px',overflow:'hidden',textOverflow:'ellipsis',whiteSpace:'nowrap',marginBottom:'8px'}}>{session.name}</div>
+    <button type="button" disabled={session.ending} onClick={() => window.parent.postMessage({type:'brave-session-end'}, window.location.origin)}
+      style={{width:'100%',padding:'7px 12px',border:0,borderRadius:'6px',background:'#f46638',color:'#fff',cursor:'pointer'}}>
+      {session.ending ? 'Ending session…' : 'End session'}
+    </button>
+    {session.error && <p role="alert" style={{fontSize:'12px',marginTop:'8px'}}>{session.error}</p>}
+  </section>;
+}
 
