+    async def delete_file_handler(self, request):
+        # Enabled only by the private-desktop launcher. The gateway authenticates
+        # the user; this handler still requires an explicit same-origin mutation.
+        if os.environ.get("BRAVE_PRIVATE_FILES") != "true":
+            raise web.HTTPForbidden()
+        if request.headers.get("X-My-Files-Action") != "delete":
+            raise web.HTTPForbidden()
+        origin = urllib.parse.urlsplit(request.headers.get("Origin", ""))
+        if origin.scheme not in ("http", "https") or origin.netloc != request.host:
+            raise web.HTTPForbidden()
+        parts = request.match_info.get("path", "").split("/")
+        if not parts or any(not x or x in (".", "..") or "\\" in x or "\x00" in x for x in parts):
+            raise web.HTTPForbidden()
+        # Traverse relative to directory descriptors without following links.
+        # unlink never follows the final entry, even if it changes after stat.
+        import stat
+        fd = None
+        try:
+            fd = os.open(self.upload_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+            for part in parts[:-1]:
+                nxt = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
+                os.close(fd)
+                fd = nxt
+            info = os.stat(parts[-1], dir_fd=fd, follow_symlinks=False)
+            if not stat.S_ISREG(info.st_mode):
+                raise web.HTTPForbidden(text="Only regular files can be deleted")
+            os.unlink(parts[-1], dir_fd=fd)
+        except FileNotFoundError:
+            raise web.HTTPNotFound()
+        except OSError:
+            raise web.HTTPForbidden(text="File cannot be deleted")
+        finally:
+            if fd is not None:
+                os.close(fd)
+        return web.Response(status=204)
 
