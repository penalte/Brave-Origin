# Only build inputs may enter the Docker context.
*
!Dockerfile
!.dockerignore
!entrypoint.sh
!scripts/
!scripts/*.sh
!config/
!config/nginx.conf
!patches/
!patches/*.patch
!patches/labwc/
!patches/labwc/*.patch
!patches/labwc/README.md
!dependencies/
!dependencies/*.package-lock.json
!dependencies/runtime.txt
!tests/
!tests/client-clipboard.mjs
!tests/client-audio.mjs

!scripts/prepare-storage.py
!scripts/session-manager.py
!config/nginx-oidc.conf
!config/portal.html
!config/portal.js
