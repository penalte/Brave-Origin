# ==============================================================================
# Brave Origin in Docker (Native Wayland / Selkies) - Environment Configuration
# ==============================================================================

# --- Primary Configuration ---
IMAGE_NAME=brave-origin:pocket-id
CONFIG_PATH=./appdata
PUID=1000
PGID=1000
TZ=America/New_York
WEB_PORT=8443
ENABLE_AUDIO=true
AUTH_ENABLED=true
AUTO_UPDATE=true

# Pocket ID / generic OIDC (Wayland only). Set true to replace the local login.
OIDC_ENABLED=false
MAX_CONCURRENT_SESSIONS=2
MAX_UPLOAD_MB=1024
SESSION_START_TIMEOUT=90
OIDC_ISSUER_URL=https://id.penalte.pt
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
OIDC_SCOPES=openid profile email groups
# Optional comma-separated allowed group names; empty allows this client's users.
OIDC_ALLOWED_GROUPS=
OIDC_GROUPS_CLAIM=groups
SESSION_MAX_SECONDS=3600
DISCONNECT_GRACE_SECONDS=30
SESSION_CONNECT_TIMEOUT=90

# --- Authentication Settings (Active when AUTH_ENABLED=true) ---
# AUTH_USER=brave
AUTH_PASSWORD=
# AUTH_PASSWORD_FILE=/run/secrets/auth_password

# --- Advanced Settings (Optional Defaults) ---
# UMASK=022
# Automatically match the browser window. Width/height apply only when false.
# DISPLAY_AUTO_RESIZE=true
# Keep Brave maximized; false restores the previous window controls.
# BROWSER_LOCK_MAXIMIZED=true
# DISPLAY_WIDTH=1920
# DISPLAY_HEIGHT=1080
# CONTAINER_HOSTNAME=brave-origin
# BRAVE_ORIGIN_VERSION=latest
# BRAVE_FLAGS=
# DRI_NODE=/dev/dri/renderD128
# ENABLE_GPU=true
# UPDATE_INTERVAL=21600
# DOWNGRADE_RETRY_INTERVAL=300
# MIN_UPDATE_FREE_SPACE_MB=1024
# BRAVE_STARTUP_TIMEOUT=15
